<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.duffel.com</domain>
        <domain includeSubdomains="true">api.stripe.com</domain>
        <domain includeSubdomains="true">api.planespotters.net</domain>
        <domain includeSubdomains="true">sandbox-partners-api.airalo.com</domain>
        <domain includeSubdomains="true">partners-api.airalo.com</domain>
        <domain includeSubdomains="true">api.prioritypass.com</domain>
        <domain includeSubdomains="true">api.dragonpass.com</domain>
        <domain includeSubdomains="true">api.aviationstack.com</domain>
        <domain includeSubdomains="true">aeroapi.flightaware.com</domain>
        <domain includeSubdomains="true">api.getyourguide.com</domain>
        <domain includeSubdomains="true">api.viator.com</domain>
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">firebaseinstallations.googleapis.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
