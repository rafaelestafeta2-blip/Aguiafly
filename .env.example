# DUFFEL_API_TOKEN: Required for Duffel NDC Flight Search, Seat Maps & Order Creation (https://api.duffel.com).
# Configure via the Secrets panel in AI Studio (e.g., duffel_test_...).
DUFFEL_API_TOKEN=DUFFEL_SANDBOX_TOKEN_PLACEHOLDER

# STRIPE_PUBLISHABLE_KEY: Chave Publicável usada pelo frontend para tokenizar o cartão com segurança no dispositivo.
STRIPE_PUBLISHABLE_KEY=pk_test_... (Substitua pela sua chave publicável)

# STRIPE_SECRET_KEY: Chave Secreta usada exclusivamente pelo servidor de backend para cobrar o valor final (€3.50 + 3.5% + Tarifa Neta).
STRIPE_SECRET_KEY=sk_test_... (Substitua pela sua chave secreta)
