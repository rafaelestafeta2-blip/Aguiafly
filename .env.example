# DUFFEL_API_TOKEN / DUFFEL_API_KEY / DU: Token de acesso Duffel NDC Flights (https://api.duffel.com).
DUFFEL_API_TOKEN=DUFFEL_SANDBOX_TOKEN_PLACEHOLDER
DUFFEL_API_KEY=DUFFEL_SANDBOX_TOKEN_PLACEHOLDER
DU=DUFFEL_SANDBOX_TOKEN_PLACEHOLDER

# STRIPE_PUBLISHABLE_KEY: Chave Publicável Stripe (pk_test_... ou pk_live_...)
STRIPE_PUBLISHABLE_KEY=STRIPE_PUBLISHABLE_KEY_PLACEHOLDER

# STRIPE_SECRET_KEY: Chave Secreta Stripe (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=STRIPE_SECRET_KEY_PLACEHOLDER

# AIRALO_API_KEY: Chave de parceiro Airalo Partner API para emissão de eSIM de dados móveis globais no país de destino.
AIRALO_API_KEY=AIRALO_PARTNER_SANDBOX_KEY_PLACEHOLDER

# PRIORITY_PASS_API_KEY: Chave de integração Priority Pass / DragonPass Lounge Access para reserva de Salas VIP nos aeroportos da rota.
PRIORITY_PASS_API_KEY=PRIORITY_PASS_DRAGONPASS_SANDBOX_KEY_PLACEHOLDER

# AVIATIONSTACK_API_KEY: Chave de telemetria em tempo real FlightAware AeroAPI / Aviationstack para status de voo, terminal, portão e radar.
AVIATIONSTACK_API_KEY=AVIATIONSTACK_FLIGHTAWARE_SANDBOX_KEY_PLACEHOLDER

# GETYOURGUIDE_API_KEY: Chave de afiliado/parceiro GetYourGuide & Viator API para passeios, ingressos sem fila e transfers executivos no destino.
GETYOURGUIDE_API_KEY=GETYOURGUIDE_VIATOR_PARTNER_KEY_PLACEHOLDER

# VIATOR_API_KEY: Chave de parceiro Viator (Tripadvisor Partner API) para pacotes de experiências e tours guiados globais.
VIATOR_API_KEY=VIATOR_PARTNER_API_KEY_PLACEHOLDER

# CIVITATIS_API_KEY: Chave de parceiro/agência Civitatis API para excursões, pacotes em português e transfers privados.
CIVITATIS_API_KEY=CIVITATIS_AGENCY_API_KEY_PLACEHOLDER

# AMADEUS_API_KEY: (Reservado para ativação futura Enterprise) Chave Amadeus GDS API (https://api.amadeus.com).
AMADEUS_API_KEY=AMADEUS_ENTERPRISE_KEY_PLACEHOLDER

# AMADEUS_API_SECRET: (Reservado para ativação futura Enterprise) Segredo OAuth2 da Amadeus GDS API.
AMADEUS_API_SECRET=AMADEUS_ENTERPRISE_SECRET_PLACEHOLDER

# KIWI_TEQUILA_API_KEY: Chave gratuita da Kiwi.com Tequila API (https://tequila.kiwi.com) para busca global de voos reais (GDS + Low-Cost + Virtual Interlining).
KIWI_TEQUILA_API_KEY=KIWI_TEQUILA_API_KEY_PLACEHOLDER

# BACKEND_MIDDLEWARE_URL: URL do servidor backend-node (ex: https://api.aguiafly.com) para processar o Checkout Atômico no servidor sem expor chaves secretas no APK de produção.
BACKEND_MIDDLEWARE_URL=BACKEND_MIDDLEWARE_URL_PLACEHOLDER

