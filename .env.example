# ==============================================================================
# CONFIGURAÇÃO DE MODO DE AMBIENTE (SANDBOX / TEST MODE vs PRODUÇÃO / LIVE)
# ==============================================================================
# Se USE_TEST_APIS=true ou NODE_ENV=development:
#   O app e o backend entram automaticamente no modo Sandbox/Teste:
#   - Duffel: usa DUFFEL_API_TOKEN_TEST (ou duffel_test_...) para reservas simuladas.
#   - Stripe: usa STRIPE_PUBLISHABLE_KEY_TEST (pk_test_...) e STRIPE_SECRET_KEY_TEST (sk_test_...).
# Caso contrário (USE_TEST_APIS=false e NODE_ENV=production):
#   O app e o backend entram automaticamente no modo Produção Real:
#   - Duffel: usa DUFFEL_API_TOKEN_LIVE (ou duffel_live_...) para bilhetes reais.
#   - Stripe: usa STRIPE_PUBLISHABLE_KEY_LIVE (pk_live_...) e STRIPE_SECRET_KEY_LIVE (sk_live_...).
USE_TEST_APIS=true
NODE_ENV=development

# ==============================================================================
# DUFFEL NDC FLIGHTS API (https://api.duffel.com)
# ==============================================================================
DUFFEL_API_TOKEN_TEST=duffel_test_SANDBOX_TOKEN_PLACEHOLDER
DUFFEL_API_TOKEN_LIVE=duffel_live_PRODUCTION_TOKEN_PLACEHOLDER
DUFFEL_API_TOKEN=DUFFEL_SANDBOX_TOKEN_PLACEHOLDER
DUFFEL_API_KEY=DUFFEL_SANDBOX_TOKEN_PLACEHOLDER
DU=DUFFEL_SANDBOX_TOKEN_PLACEHOLDER

# ==============================================================================
# STRIPE PAYMENTS (https://dashboard.stripe.com)
# ==============================================================================
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=STRIPE_PUBLISHABLE_KEY_PLACEHOLDER

STRIPE_SECRET_KEY_TEST=sk_test_PLACEHOLDER
STRIPE_SECRET_KEY_LIVE=sk_live_PLACEHOLDER
STRIPE_SECRET_KEY=STRIPE_SECRET_KEY_PLACEHOLDER

# ==============================================================================
# PARCEIROS DE VIAGEM & ANCILLARIES
# ==============================================================================
# AIRALO_API_KEY: Chave de parceiro Airalo Partner API para emissão de eSIM de dados móveis globais.
AIRALO_API_KEY=AIRALO_PARTNER_SANDBOX_KEY_PLACEHOLDER

# PRIORITY_PASS_API_KEY: Chave Priority Pass / DragonPass para reserva de Salas VIP nos aeroportos.
PRIORITY_PASS_API_KEY=PRIORITY_PASS_DRAGONPASS_SANDBOX_KEY_PLACEHOLDER

# AVIATIONSTACK_API_KEY: Telemetria em tempo real Aviationstack / FlightAware AeroAPI.
AVIATIONSTACK_API_KEY=AVIATIONSTACK_FLIGHTAWARE_SANDBOX_KEY_PLACEHOLDER

# GETYOURGUIDE_API_KEY: Afiliado/parceiro GetYourGuide & Viator API para passeios no destino.
GETYOURGUIDE_API_KEY=GETYOURGUIDE_VIATOR_PARTNER_KEY_PLACEHOLDER

# VIATOR_API_KEY: Parceiro Viator (Tripadvisor Partner API) para pacotes e experiências guiadas.
VIATOR_API_KEY=VIATOR_PARTNER_API_KEY_PLACEHOLDER

# CIVITATIS_API_KEY: Agência Civitatis API para excursões e transfers privados.
CIVITATIS_API_KEY=CIVITATIS_AGENCY_API_KEY_PLACEHOLDER

# AMADEUS_API_KEY & SECRET: (Reservado para ativação futura Enterprise) Chave Amadeus GDS API.
AMADEUS_API_KEY=AMADEUS_ENTERPRISE_KEY_PLACEHOLDER
AMADEUS_API_SECRET=AMADEUS_ENTERPRISE_SECRET_PLACEHOLDER

# KIWI_TEQUILA_API_KEY: Chave gratuita Kiwi.com Tequila API para busca global de voos reais.
KIWI_TEQUILA_API_KEY=KIWI_TEQUILA_API_KEY_PLACEHOLDER

# BACKEND_MIDDLEWARE_URL: URL do servidor backend-node (ex: https://api.aguiafly.com)
BACKEND_MIDDLEWARE_URL=BACKEND_MIDDLEWARE_URL_PLACEHOLDER
