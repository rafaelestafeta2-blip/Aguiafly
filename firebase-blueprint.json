{
  "entities": {
    "Ticket": {
      "title": "Ticket",
      "description": "An issued E-Ticket from Duffel NDC and Stripe payment in EUR.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "orderId": { "type": "string", "description": "Duffel Order ID" },
        "bookingReference": { "type": "string", "description": "6-char airline PNR" },
        "passengerName": { "type": "string", "description": "Full passenger name" },
        "originIata": { "type": "string", "description": "Origin 3-letter IATA code" },
        "originCity": { "type": "string", "description": "Origin city name" },
        "destinationIata": { "type": "string", "description": "Destination 3-letter IATA code" },
        "destinationCity": { "type": "string", "description": "Destination city name" },
        "departureIso": { "type": "string", "description": "Departure timestamp ISO-8601" },
        "arrivalIso": { "type": "string", "description": "Arrival timestamp ISO-8601" },
        "airlineName": { "type": "string", "description": "Operating carrier name" },
        "flightNumber": { "type": "string", "description": "Flight number e.g. AF1024" },
        "aircraftName": { "type": "string", "description": "Aircraft model e.g. Airbus A350-900" },
        "cabinClass": { "type": "string", "enum": ["economy", "premium_economy", "business", "first"] },
        "seatDesignator": { "type": "string", "description": "Assigned seat e.g. 2A" },
        "netAmountEur": { "type": "number", "description": "Duffel net fare in EUR" },
        "markupEur": { "type": "number", "description": "OTA dynamic profit margin in EUR" },
        "ancillariesEur": { "type": "number", "description": "Ancillaries total in EUR" },
        "totalChargedEur": { "type": "number", "description": "Total charged via Stripe in EUR" },
        "iataBarcodePayload": { "type": "string", "description": "IATA BCBP boarding pass barcode payload" },
        "addedToGoogleWallet": { "type": "boolean", "description": "Whether added to Google Wallet" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "orderId",
        "bookingReference",
        "passengerName",
        "originIata",
        "originCity",
        "destinationIata",
        "destinationCity",
        "departureIso",
        "arrivalIso",
        "airlineName",
        "flightNumber",
        "aircraftName",
        "cabinClass",
        "seatDesignator",
        "netAmountEur",
        "markupEur",
        "ancillariesEur",
        "totalChargedEur",
        "iataBarcodePayload",
        "addedToGoogleWallet",
        "createdAt",
        "updatedAt"
      ]
    },
    "MarkupConfig": {
      "title": "MarkupConfig",
      "description": "Dynamic profit markup rules configured by the OTA operator per user account.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "fixedMarkupEur": { "type": "number", "description": "Fixed EUR fee added to net fare" },
        "percentageMarkup": { "type": "number", "description": "Percentage margin added to net fare" },
        "seatSelectionFeeEur": { "type": "number", "description": "OTA service fee for seat selection in EUR" },
        "extraBaggageFeeEur": { "type": "number", "description": "OTA fee for extra 23kg bag in EUR" },
        "priorityBoardingFeeEur": { "type": "number", "description": "OTA fee for priority boarding & lounge in EUR" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "fixedMarkupEur",
        "percentageMarkup",
        "seatSelectionFeeEur",
        "extraBaggageFeeEur",
        "priorityBoardingFeeEur",
        "updatedAt"
      ]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "User subscription for promotional fare monitoring and FCM push notifications on a specific route.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "originIata": { "type": "string", "description": "Origin 3-letter IATA airport code" },
        "destinationIata": { "type": "string", "description": "Destination 3-letter IATA airport code" },
        "cabinClass": { "type": "string", "enum": ["economy", "premium_economy", "business", "first"] },
        "targetMaxPriceEur": { "type": "number", "description": "Maximum target promotional price in EUR" },
        "baselinePriceEur": { "type": "number", "description": "Reference fare in EUR when the alert was created" },
        "lastObservedPriceEur": { "type": "number", "description": "Most recent observed fare in EUR from cron check" },
        "fcmToken": { "type": "string", "description": "Device Firebase Cloud Messaging registration token" },
        "isActive": { "type": "boolean", "description": "Whether push alert monitoring is active" },
        "promoTriggered": { "type": "boolean", "description": "Whether a promotional fare drop was found" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "originIata",
        "destinationIata",
        "cabinClass",
        "targetMaxPriceEur",
        "baselinePriceEur",
        "lastObservedPriceEur",
        "fcmToken",
        "isActive",
        "promoTriggered",
        "createdAt",
        "updatedAt"
      ]
    },
    "TravelerProfile": {
      "title": "TravelerProfile",
      "description": "Saved traveler profile vault for fast checkout auto-fill scoped to the authenticated user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "firstName": { "type": "string", "description": "Traveler first name as on passport" },
        "lastName": { "type": "string", "description": "Traveler surname as on passport" },
        "email": { "type": "string", "description": "Contact email for E-Ticket delivery" },
        "phone": { "type": "string", "description": "International phone number" },
        "documentNumber": { "type": "string", "description": "Official passport or national ID number" },
        "birthDate": { "type": "string", "description": "Birth date YYYY-MM-DD" },
        "expiryDate": { "type": "string", "description": "Document expiry date YYYY-MM-DD" },
        "frequentFlyerProgram": { "type": "string", "description": "Frequent flyer program code or name" },
        "frequentFlyerNumber": { "type": "string", "description": "Frequent flyer membership number" },
        "autoCheckInEnabled": { "type": "boolean", "description": "Whether automatic check-in is enabled by default" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "firstName",
        "lastName",
        "email",
        "phone",
        "documentNumber",
        "birthDate",
        "expiryDate",
        "frequentFlyerProgram",
        "frequentFlyerNumber",
        "autoCheckInEnabled",
        "updatedAt"
      ]
    },
    "PassportVisualProfile": {
      "title": "PassportVisualProfile",
      "description": "Cloud-persisted visual profile, avatar photo, cover photo, cover theme preset, nationality, and passport stamp photo albums scoped to the authenticated user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "profilePhotoData": { "type": "string", "description": "Compact Base64 JPEG data URI or URL for user profile avatar" },
        "coverPhotoData": { "type": "string", "description": "Compact Base64 JPEG data URI or URL for user cover photo" },
        "coverPreset": { "type": "string", "description": "Selected executive cover theme preset name" },
        "nationality": { "type": "string", "description": "Displayed nationality on the digital passport" },
        "memberTierTitle": { "type": "string", "description": "Displayed member tier / bio subtitle" },
        "passportCustomNumber": { "type": "string", "description": "Displayed passport number override" },
        "stampPhotosJson": { "type": "string", "description": "JSON map of ticket stamp keys to compact Base64 JPEG photo lists" },
        "stampNotesJson": { "type": "string", "description": "JSON map of ticket stamp keys to custom notes" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "profilePhotoData",
        "coverPhotoData",
        "coverPreset",
        "nationality",
        "memberTierTitle",
        "passportCustomNumber",
        "stampPhotosJson",
        "stampNotesJson",
        "updatedAt"
      ]
    },
    "HolidayPackage": {
      "title": "HolidayPackage",
      "description": "Manually curated or partner agency holiday package and exclusive experience managed via AguiaFly Admin CMS.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner/Admin Firebase Auth UID" },
        "packageCode": { "type": "string", "description": "Unique package reference code" },
        "title": { "type": "string", "description": "Experience or holiday package title" },
        "destinationCity": { "type": "string", "description": "Destination city and country" },
        "destinationIata": { "type": "string", "description": "3-letter IATA airport code for destination" },
        "durationLabel": { "type": "string", "description": "Formatted duration e.g. 7 Noites / 8 Dias" },
        "durationNights": { "type": "number", "description": "Number of nights" },
        "netPricePerPersonEur": { "type": "number", "description": "Partner net base price per person in EUR" },
        "aguiaflyCommissionPercent": { "type": "number", "description": "AguiaFly commission percentage markup" },
        "aguiaflyFixedFeeEur": { "type": "number", "description": "AguiaFly fixed fee per person in EUR" },
        "finalPricePerPersonEur": { "type": "number", "description": "Final display price per person in EUR" },
        "depositPercentage": { "type": "number", "description": "Allowed deposit percentage e.g. 25" },
        "availableSpots": { "type": "number", "description": "Remaining available spots in inventory" },
        "totalSpots": { "type": "number", "description": "Total capacity spots" },
        "partnerAgencyName": { "type": "string", "description": "Partner agency or operator name" },
        "sourceType": { "type": "string", "enum": ["MANUAL_CMS", "GETYOURGUIDE_API", "VIATOR_API", "CIVITATIS_API"] },
        "badgeType": { "type": "string", "enum": ["TUDO_INCLUIDO", "EXCLUSIVO_AGUIAFLY", "ULTIMAS_VAGAS", "PARCEIRO_OFICIAL"] },
        "inclusionsCsv": { "type": "string", "description": "Comma-separated inclusion codes: FLIGHT,HOTEL,MEALS,GUIDE,TRANSFERS" },
        "galleryPhotosJson": { "type": "string", "description": "JSON array of HD photo URLs" },
        "itineraryDaysJson": { "type": "string", "description": "JSON array of day-by-day itinerary items" },
        "routeWaypointsJson": { "type": "string", "description": "JSON array of interactive map waypoints" },
        "isActive": { "type": "boolean", "description": "Whether package is active in catalog" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "packageCode",
        "title",
        "destinationCity",
        "destinationIata",
        "durationLabel",
        "durationNights",
        "netPricePerPersonEur",
        "aguiaflyCommissionPercent",
        "aguiaflyFixedFeeEur",
        "finalPricePerPersonEur",
        "depositPercentage",
        "availableSpots",
        "totalSpots",
        "partnerAgencyName",
        "sourceType",
        "badgeType",
        "inclusionsCsv",
        "galleryPhotosJson",
        "itineraryDaysJson",
        "routeWaypointsJson",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "PackageBooking": {
      "title": "PackageBooking",
      "description": "Direct Stripe checkout booking or reservation deposit for a holiday package or partner API experience.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "bookingCode": { "type": "string", "description": "6-8 char confirmation code" },
        "packageId": { "type": "string", "description": "Referenced package ID" },
        "packageTitle": { "type": "string", "description": "Package title" },
        "destinationCity": { "type": "string", "description": "Destination city" },
        "destinationIata": { "type": "string", "description": "Destination IATA code" },
        "durationLabel": { "type": "string", "description": "Duration label e.g. 7 Noites" },
        "sourceType": { "type": "string", "enum": ["MANUAL_CMS", "GETYOURGUIDE_API", "VIATOR_API", "CIVITATIS_API"] },
        "partnerName": { "type": "string", "description": "Partner agency or API provider name" },
        "partnerConfirmationCode": { "type": "string", "description": "Partner confirmation reference" },
        "travelerFullName": { "type": "string", "description": "Lead traveler full name" },
        "travelerEmail": { "type": "string", "description": "Lead traveler email" },
        "travelerPhone": { "type": "string", "description": "Lead traveler phone" },
        "guestsCount": { "type": "number", "description": "Number of booked spots/guests" },
        "paymentMode": { "type": "string", "enum": ["FULL_PAYMENT", "DEPOSIT_SIGNAL"] },
        "totalPackageGrossEur": { "type": "number", "description": "Total package price in EUR" },
        "amountChargedNowEur": { "type": "number", "description": "Amount charged via Stripe now in EUR" },
        "remainingBalanceEur": { "type": "number", "description": "Remaining balance due in EUR" },
        "aguiaflyCommissionEur": { "type": "number", "description": "Total AguiaFly commission included in EUR" },
        "stripeChargeId": { "type": "string", "description": "Stripe charge or payment intent ID" },
        "status": { "type": "string", "enum": ["CONFIRMED", "DEPOSIT_PAID", "CANCELLED"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "bookingCode",
        "packageId",
        "packageTitle",
        "destinationCity",
        "destinationIata",
        "durationLabel",
        "sourceType",
        "partnerName",
        "partnerConfirmationCode",
        "travelerFullName",
        "travelerEmail",
        "travelerPhone",
        "guestsCount",
        "paymentMode",
        "totalPackageGrossEur",
        "amountChargedNowEur",
        "remainingBalanceEur",
        "aguiaflyCommissionEur",
        "stripeChargeId",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/Ticket" },
      "description": "User E-Tickets issued via Duffel and Stripe"
    },
    "/markup_configs/{userId}": {
      "schema": { "$ref": "#/entities/MarkupConfig" },
      "description": "Dynamic OTA profit markup configuration scoped to userId"
    },
    "/price_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "Route price alert subscriptions with FCM push notification tokens"
    },
    "/traveler_profiles/{userId}": {
      "schema": { "$ref": "#/entities/TravelerProfile" },
      "description": "Saved traveler profile vault per authenticated user"
    },
    "/passport_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PassportVisualProfile" },
      "description": "Cloud-saved profile photo, cover photo, cover preset, and passport stamp photos per authenticated user"
    },
    "/holiday_packages/{packageId}": {
      "schema": { "$ref": "#/entities/HolidayPackage" },
      "description": "Admin CMS holiday packages and curated partner experiences"
    },
    "/package_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/PackageBooking" },
      "description": "Direct Stripe bookings and reservation deposits for holiday packages and API experiences"
    }
  }
}
